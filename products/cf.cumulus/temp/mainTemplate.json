{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.35.1.17967",
      "templateHash": "14600197890793401079"
    }
  },
  "parameters": {
    "orgName": {
      "type": "string",
      "defaultValue": "cfc",
      "metadata": {
        "description": "The naming prefix for all resources to be deployed."
      }
    },
    "domainName": {
      "type": "string",
      "defaultValue": "demo",
      "metadata": {
        "description": "The optional middle part naming for all resources to be deployment. Suggested as the business unit, project or domain."
      }
    },
    "envName": {
      "type": "string",
      "defaultValue": "dev, tst, prd",
      "metadata": {
        "description": "The environment name abbreviation used for the deployment."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "uksouth",
      "metadata": {
        "description": "The Azure region where all resources will be deployed."
      }
    },
    "datalakeName": {
      "type": "string",
      "defaultValue": "dls",
      "metadata": {
        "description": "Optional naming abbreviation for the Azure Data Lake Storage account."
      }
    },
    "functionStorageName": {
      "type": "string",
      "defaultValue": "st",
      "metadata": {
        "description": "Optional naming abbreviation for the Azure Storage account used to support the Azure Functions App."
      }
    },
    "uniqueIdentifier": {
      "type": "string",
      "defaultValue": "01",
      "metadata": {
        "description": "The numeric identifier for all resources as a naming suffix, used to differentiate between instances of resources."
      }
    },
    "databricksSKU": {
      "type": "string",
      "defaultValue": "Premium",
      "allowedValues": [
        "Premium",
        "Standard"
      ],
      "metadata": {
        "description": "The product SKU for the Azure Databricks workspace."
      }
    },
    "aspSKU": {
      "type": "string",
      "defaultValue": "consumption",
      "allowedValues": [
        "premium",
        "consumption"
      ],
      "metadata": {
        "description": "The product SKU for the App Service Plan used by the Azure Function App."
      }
    },
    "deploymentTimestamp": {
      "type": "string",
      "defaultValue": "[utcNow('yy-MM-dd-HHmm')]",
      "metadata": {
        "description": "A timestamp format used for the deployment execution naming only. Used to differentiate between instances of resources deployed."
      }
    }
  },
  "variables": {
    "locationShortCodes": {
      "uksouth": "uks",
      "ukwest": "ukw",
      "eastus": "eus",
      "westus": "wus",
      "westus2": "wus2",
      "centralus": "cus",
      "northcentralus": "ncus",
      "southcentralus": "scus",
      "eastus2": "eus2",
      "westeurope": "weu",
      "northeurope": "neu",
      "francecentral": "frc",
      "germanywestcentral": "gwc",
      "switzerlandnorth": "swn",
      "norwayeast": "noe",
      "brazilsouth": "brs",
      "canadacentral": "cac",
      "canadaeast": "cae"
    },
    "locationShortCode": "[variables('locationShortCodes')[parameters('location')]]",
    "namePrefix": "[format('{0}{1}{2}', parameters('orgName'), parameters('domainName'), parameters('envName'))]",
    "nameSuffix": "[format('{0}{1}', variables('locationShortCode'), parameters('uniqueIdentifier'))]",
    "rgName": "[format('{0}rg{1}', variables('namePrefix'), variables('nameSuffix'))]"
  },
  "resources": [
    {
        "type": "Microsoft.Resources/deploymentScripts",
        "apiVersion": "2023-08-01",
        "name": "run-external-script",
        "location": "[parameters('location')]",
        "kind": "AzurePowerShell",
        "properties": {
            "azPowerShellVersion": "10.4",
            "timeout": "PT30M",
            "cleanupPreference": "OnSuccess",
            "retentionInterval": "P1H",
            "arguments": "[concat('-tenantId ', subscription().tenantId, ' -subscriptionId ', subscription().subscriptionId, ' -location ', parameters('location'), ' -resourcePrefix ', variables('namePrefix'), ' -resourceSuffix ', variables('nameSuffix'), ' -resourceGroupName ', variables('rgName'))]",
            "scriptContent": "Invoke-WebRequest -Uri 'https://raw.githubusercontent.com/CloudFormations/CF.Marketplace/refs/heads/develop_powershell/products/cf.cumulus/temp/postDeploymentsScript.ps1' -OutFile \"$env:TEMP\\postDeploymentsScript.ps1\"; . \"$env:TEMP\\postDeploymentsScript.ps1\" -tenantId $env:tenantId -subscriptionId $env:subscriptionId -location $env:location -resourcePrefix $env:resourcePrefix -resourceSuffix $env:resourceSuffix -resourceGroupName $env:resourceGroupName"
        }
    }
  ],
  "outputs": {
  }
}